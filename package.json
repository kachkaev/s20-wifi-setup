{
  "name": "s20-wifi-setup",
  "version": "1.0.2",
  "description": "Connect legacy Orvibo Wiwo S20 smart sockets to Wi-Fi from the terminal",
  "keywords": [
    "orvibo",
    "wiwo",
    "s20",
    "smart-socket",
    "smart-plug",
    "home-assistant",
    "wifi",
    "pairing",
    "cli",
    "effect",
    "effect-ts"
  ],
  "homepage": "https://github.com/kachkaev/s20-wifi-setup#readme",
  "bugs": {
    "url": "https://github.com/kachkaev/s20-wifi-setup/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kachkaev/s20-wifi-setup.git"
  },
  "license": "BSD-3-Clause",
  "author": {
    "name": "Alexander Kachkaev",
    "email": "alexander@kachkaev.ru",
    "url": "https://en.kachkaev.ru"
  },
  "type": "module",
  "bin": {
    "s20-wifi-setup": "./dist/cli.js"
  },
  "files": [
    "LICENSE.md",
    "README.md",
    "dist/"
  ],
  "scripts": {
    "build": "vite build",
    "changesets:publish": "changeset publish",
    "changesets:version": "changeset version && pnpm install --lockfile-only --no-frozen-lockfile",
    "fix": "npm-run-all --continue-on-error \"fix:*\"",
    "fix:eslint": "eslint --max-warnings=0 --fix",
    "fix:knip": "knip --fix",
    "fix:markdownlint": "markdownlint --dot --fix .",
    "fix:pnpm-dedupe": "pnpm dedupe",
    "fix:prettier": "prettier --write .",
    "lint": "npm-run-all --continue-on-error \"lint:*\"",
    "lint:cspell": "cspell --cache --cache-location=node_modules/.cache/cspell/.cspellcache --cache-strategy=content --dot --no-progress \"**/*\"",
    "lint:eslint": "eslint --max-warnings=0",
    "lint:knip": "knip",
    "lint:markdownlint": "markdownlint --dot .",
    "lint:pnpm-dedupe": "pnpm dedupe --check",
    "lint:prettier": "prettier --check .",
    "lint:tsc": "tsc --noEmit",
    "prepack": "pnpm build",
    "prepare": "node .husky/install.mjs",
    "test": "node --test tests/*.test.ts"
  },
  "lint-staged": {
    "**": [
      "prettier --ignore-unknown --write"
    ]
  },
  "prettier": "@kachkaev/prettier-config",
  "devDependencies": {
    "@changesets/changelog-github": "0.6.0",
    "@changesets/cli": "2.31.0",
    "@changesets/config": "3.1.4",
    "@effect/platform-node": "4.0.0-beta.59",
    "@kachkaev/eslint-config-base": "1.1.1",
    "@kachkaev/markdownlint-config": "1.0.1",
    "@kachkaev/prettier-config": "2.2.1",
    "@tsconfig/node-ts": "23.6.4",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.12.2",
    "cspell": "10.0.0",
    "effect": "4.0.0-beta.59",
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "knip": "6.11.0",
    "lint-staged": "16.4.0",
    "markdownlint-cli": "0.48.0",
    "npm-run-all2": "8.0.4",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "vite": "7.2.0"
  },
  "packageManager": "pnpm@12.3.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.22.2",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
